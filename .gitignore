# dependencies
node_modules
.pnp
.pnp.js

# build output
dist
dist-ssr
*.local

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor / OS
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# environment
.env
.env.local
.env.*.local

# vercel
.vercel

# claude-specific local state
.claude

# template messaggi privati per i clienti (contengono IBAN, prezzi, dati personali)
# devono restare solo in locale, MAI su GitHub o Vercel.
# NOTA: ignoro tutti i file al primo livello e poi "ri-permetto" solo la
# sottocartella newsletter/, perche' i suoi file (no dati sensibili) devono
# essere disponibili in produzione per /api/newsletter/send.
messaggi-clienti/*
!messaggi-clienti/newsletter/
!messaggi-clienti/newsletter/**

# script di test/diagnosi temporanei (vivono solo in locale)
scripts/_tmp_*

# bozze delle mail ai singoli lead/clienti composte in scripts/ (es.
# scripts/<nome>-<oggetto>.html|.txt, passate a send_lead.mjs con --html/--text):
# contengono NOMI e contenuti personali, stessa sostanza di messaggi-clienti/.
# Restano in locale, MAI su GitHub o Vercel. Gli script veri (.mjs/.js) NON sono
# toccati da questa regola.
scripts/*.html
scripts/*.txt

# anteprime PDF dei manuali: NON pubblicarle dal sito.
# Vengono consegnate via link Google Drive a chi le richiede esplicitamente
# (skill deliver-anteprima-manuale - work in progress).
# I file restano in locale per la generazione/upload su Drive.
public/preview/**/manuale-anteprima.pdf

# bundle prototipi Claude Design (asset di riferimento, restano in locale)
.design-bundle/
.design-bundle-v3/

# materiale social (bozze post Telegram/IG/ecc.) — solo locale, MAI su Git/Vercel
social/

# knowledge graph generato da graphify: artefatto rigenerabile (`graphify update .`),
# la cache AST cambierebbe a ogni run sporcando i diff. Resta locale.
graphify-out/

# presentazioni/seminari derivati dai manuali (PDF+PPTX pesanti): non servono al
# deploy e gonfierebbero il bundle Vercel. Restano in locale.
docs/

.vercel
